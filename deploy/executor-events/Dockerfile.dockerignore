# BuildKit reads this instead of the root .dockerignore for
# deploy/executor-events/Dockerfile. Only the Cargo workspace is sent.
*
!rust-toolchain.toml
!Cargo.toml
!Cargo.lock
!.cargo/
!crates/
!deploy/build-tools/
crates/*/tests
crates/*/scripts
crates/*/target
crates/*/dist
crates/xtask/node
**/node_modules
**/.DS_Store
